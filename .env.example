
## Only if you use Linear for tracking actions, otherwise ignore.
LINEAR_API_KEY=ADVISORY_BORD_LINEAR_API_KEY

## Plane.so — primary tracker. The workspace-scoped API token below is the only secret;
## the workspace slug + project map live in tools/plane.config (copy tools/plane.config.example).
PLANE_TOKEN=    # Plane API token (secret). Workspace + project IDs: copy tools/plane.config.example -> tools/plane.config

## Weblate personal API token (https://hosted.weblate.org/accounts/profile/#api)
## Used by the /review-l10n skill to PATCH translations and post suggestions/comments.
WLT_TOKEN=your-weblate-personal-token