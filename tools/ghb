#!/usr/bin/env bash
set -euo pipefail

# `gh` as the pocketpal-dev-team bot. Use for every public write the pipeline
# makes on GitHub — PR create, PR/issue comments, review comments, request-
# changes — so readers see who wrote it. Reads can go through either.
#
# Approvals and merges stay on the operator's account: `ghb pr merge` and
# `ghb pr review --approve` are refused.
#
# Token minting: tools/gh-app-token.sh (exit 3 when the bot is not configured).

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case " $* " in
  *" pr merge "*)   echo "ghb: merging stays on the operator's account; use plain gh" >&2; exit 2 ;;
  *" --approve "*)  echo "ghb: approvals stay on the operator's account; use plain gh" >&2; exit 2 ;;
  *" auth "*)       echo "ghb: auth is managed by tools/gh-app-token.sh" >&2; exit 2 ;;
esac

token="$("$here/gh-app-token.sh")" || exit 3
GH_TOKEN="$token" GITHUB_TOKEN="$token" exec gh "$@"
