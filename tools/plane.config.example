# tools/plane.config  — Plane connection config (sourced by tools/plane.sh)
#
# Copy this file to tools/plane.config and fill in your real values.
# tools/plane.config is gitignored; this .example is committed so people know
# how to set it up. The secret PLANE_TOKEN lives in .env, not here.

# Your Plane workspace slug (the part after the domain in your Plane URL).
PLANE_WORKSPACE="your-workspace-slug"

# One entry per project: "CODE|Project Name|project-uuid"
#   CODE is the short prefix used in work-item references (e.g. POC-123).
PLANE_PROJECTS=(
  "POC|PocketPal|00000000-0000-0000-0000-000000000000"
  "PAL|PalsHub|00000000-0000-0000-0000-000000000000"
  "ADV|Advisory Actions|00000000-0000-0000-0000-000000000000"
)
