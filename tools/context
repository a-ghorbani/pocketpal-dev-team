#!/usr/bin/env python3
"""Local-only lessons store and search over past work (AGENTS.md, "Lessons").

  tools/context index                 every lesson: name, type, description
  tools/context search <terms...>     rank lessons, past stories, reviews, and flow docs
  tools/context lint [--fix]          check lessons; --fix regenerates the index
  tools/context sync [message]        lint --fix, then commit context-private/ locally
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STORE = ROOT / "context-private"
LESSONS = STORE / "lessons"
APP = ROOT / "repos" / "pocketpal-ai"
KINDS = [  # (kind, glob, weight)
    ("lesson", "context-private/lessons/*.md", 3.0),
    ("flow", "context/architecture/*.md", 2.0),
    ("story", "workflows/stories/*/*.md", 1.5),
    ("review", "workflows/reviews/*/round-*/final.md", 1.5),
]
STOP = set("the and for with that this from into when what have not are was but its our can use how does all any".split())


def frontmatter(path):
    text = path.read_text(errors="replace")
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return {}, text
    meta = {}
    for line in m.group(1).splitlines():
        kv = re.match(r"\s*(name|description|type):\s*(.*)", line)
        if kv:
            meta[kv.group(1)] = kv.group(2).strip().strip('"').replace('\\"', '"')
    return meta, text[m.end():]


def lessons():
    return sorted(LESSONS.glob("*.md")) if LESSONS.is_dir() else []


def cmd_index(_):
    for p in lessons():
        meta, _ = frontmatter(p)
        print(f"{p.stem} [{meta.get('type', '?')}]: {meta.get('description', '')}")


def cmd_search(args):
    terms = [t for t in (w.lower() for w in re.findall(r"[\w.#/-]+", " ".join(args))) if len(t) >= 3 and t not in STOP]
    if not terms:
        sys.exit("usage: tools/context search <terms...>")
    hits = []
    for kind, pattern, weight in KINDS:
        for p in ROOT.glob(pattern):
            text = p.read_text(errors="replace")
            low = text.lower()
            found = [t for t in terms if t in low]
            if not found:
                continue
            score = weight * (len(found) * 2 + min(sum(low.count(t) for t in found), 10) / 10)
            best = max(text.splitlines(), key=lambda l: sum(t in l.lower() for t in found), default="")
            if kind == "lesson":
                best = frontmatter(p)[0].get("description", best)
            hits.append((score, kind, p.relative_to(ROOT), best.strip()[:160]))
    for score, kind, path, line in sorted(hits, key=lambda h: -h[0])[:20]:
        print(f"{kind:6} {path}\n       {line}")


def check(fix):
    problems, names = [], {p.stem for p in lessons()}
    for p in lessons():
        meta, body = frontmatter(p)
        for field in ("name", "description", "type"):
            if not meta.get(field):
                problems.append(f"{p.name}: missing {field}")
        if meta.get("name") and meta["name"] != p.stem:
            problems.append(f"{p.name}: name '{meta['name']}' differs from the file name")
        for ref in re.findall(r"`((?:src|e2e|tools|skills|agents|docs|android|ios|jest)/[\w./-]+)`", body):
            ignored = subprocess.run(["git", "-C", str(APP), "check-ignore", "-q", ref]).returncode == 0
            if not ignored and not (ROOT / ref).exists() and not (APP / ref).exists():
                problems.append(f"{p.name}: names `{ref}`, which no longer exists (stale?)")
        for link in re.findall(r"\[\[([\w-]+)\]\]", body):
            if link not in names:
                problems.append(f"{p.name}: links [[{link}]], which has no lesson yet")
    if fix:
        lines = ["# Lessons", "", "Local only; never published. Generated by `tools/context lint --fix`.", ""]
        for p in lessons():
            meta, _ = frontmatter(p)
            lines.append(f"- [{p.stem}](lessons/{p.name}) [{meta.get('type', '?')}]: {meta.get('description', '')}")
        (STORE / "README.md").write_text("\n".join(lines) + "\n")
    return problems


def cmd_lint(args):
    problems = check("--fix" in args)
    print("\n".join(problems) or "lessons OK")


def cmd_sync(args):
    for problem in check(fix=True):
        print(problem)
    if not (STORE / ".git").is_dir():
        subprocess.run(["git", "init", "-q", str(STORE)], check=True)
    git = ["git", "-C", str(STORE)]
    subprocess.run(git + ["add", "-A"], check=True)
    if subprocess.run(git + ["diff", "--cached", "--quiet"]).returncode:
        subprocess.run(git + ["commit", "-q", "-m", " ".join(args) or "update lessons"], check=True)
        print("committed")
    else:
        print("no changes")


COMMANDS = {"index": cmd_index, "search": cmd_search, "lint": cmd_lint, "sync": cmd_sync}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(__doc__)
    COMMANDS[sys.argv[1]](sys.argv[2:])
