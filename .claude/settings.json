{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Agent",
      "Skill",
      "Edit(**/worktrees/**)",
      "Write(**/worktrees/**)",
      "Edit(**/pocketpal-dev-team/**)",
      "Write(**/pocketpal-dev-team/**)",
      "Edit(pocketpal-dev-team/**)",
      "Write(pocketpal-dev-team/**)",
      "Edit(worktrees/**)",
      "Write(worktrees/**)",
      "Write(**/workflows/**)",
      "Write(workflows/**)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.*)",
      "Edit(**/.env.*)",
      "Write(.env)",
      "Write(**/.env)",
      "Write(.env.*)",
      "Write(**/.env.*)",
      "Edit(**/repos/pocketpal-ai/**)",
      "Write(**/repos/pocketpal-ai/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/block-commit-to-main.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/guard-submodule-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/guard-submodule-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/guard-worktree-ops.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/guard-submodule-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(*git worktree add*)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/post-worktree-copy-env.sh"
          }
        ]
      }
    ]
  }
}
