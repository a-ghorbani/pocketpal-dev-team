{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Agent",
      "Skill",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.*)",
      "Edit(**/.env.*)",
      "Edit(**/repos/pocketpal-ai/**)",
      "Read(**/*.pem)",
      "Read(**/gh-app-token.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/block-commit-to-main.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/guard-submodule-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/guard-submodule-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/guard-worktree-ops.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/guard-submodule-git.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/guard-secrets-read.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/guard-secrets-read.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/post-worktree-copy-env.sh"
          }
        ]
      }
    ]
  }
}
